# Binance API credentials
GRID_BOT_API_KEY=your_api_key_here
GRID_BOT_API_SECRET=your_api_secret_here

# Trading pair
GRID_BOT_SYMBOL=BTCUSDT

# Grid parameters
GRID_BOT_UPPER_PRICE=50000.0
GRID_BOT_LOWER_PRICE=40000.0
GRID_BOT_GRID_LEVELS=10
GRID_BOT_GRID_TYPE=arithmetic

# Investment
GRID_BOT_TOTAL_INVESTMENT=1000.0

# Risk management (optional)
# GRID_BOT_STOP_LOSS_PRICE=39000.0
# GRID_BOT_TAKE_PROFIT_PRICE=55000.0

# Operational
GRID_BOT_TESTNET=false
GRID_BOT_DRY_RUN=true
GRID_BOT_LOG_LEVEL=INFO
